      "name": "Wishlist API (Supabase + AI)"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Extract raw TwiML string from $json.data (or fallback fields)\nlet rawData = $json.data || $json.twiml_xml || $json.whatsapp_message || '';\nif (typeof rawData !== 'string') {\n  rawData = JSON.stringify(rawData);\n}\n\n// Extract text inside <Message>...</Message> element\nconst match = rawData.match(/<Message>([\\s\\S]*?)<\\/Message>/i);\nlet extracted = match ? match[1] : rawData;\n\n// Decode XML entities (&amp;, &lt;, &gt;, &quot;, &apos;)\nextracted = extracted\n  .replace(/&amp;/g, '&')\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>')\n  .replace(/&quot;/g, '\"')\n  .replace(/&apos;/g, \"'\")\n  .trim();\n\n// Return only the extracted message as requested\nreturn {\n  whatsapp_message: extracted\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        -30
      ],
      "id": "230593dc-6c38-4105-b1f4-ab635212d9a0",
